# Dental Canvas — optional cloud sync / accounts
#
# Copy this file to `.env.local` (or `.env`) and fill in your Supabase project
# values. Leave both unset to build a fully offline-only app — the account UI
# is hidden and nothing else changes.
#
# Find both values in Supabase → Project Settings → API.
#
# ⚠️  NEVER put the service role key here, and never create a VITE_* variable
#     for it. The anon key is designed to be public; Row Level Security limits
#     every table to the signed-in doctor's own rows. Account deletion runs in
#     the supabase/functions/delete-account Edge Function, where the service
#     role key is injected by the Supabase runtime and never reaches a client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ─────────────────────────────────────────────────────────────────────
# Hosted web app (Vercel, multi-tenant)
# ─────────────────────────────────────────────────────────────────────
#
# The hosted deployment is a real multi-tenant service: each clinic's rows
# live in their own table namespace, and every API call must carry a
# Supabase session so the server knows which clinic it belongs to.
#
# On Vercel, set these under Project → Settings → Environment Variables.
# Do NOT commit real values.

# SQLite database for the deployed app (Turso / libSQL).
# Local development falls back to a file at ./.data/dental-canvas.db when unset.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# The two public Supabase values again, for the server. It uses them to verify
# access tokens and serves them to the browser (GET /api/config), so a hosted
# build needs no VITE_SUPABASE_* copies. Without them the API runs in
# single-practice mode (no sign-in), which is only appropriate for a private
# self-hosted copy.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key

# Where the browser build sends API calls. Leave unset for same-origin
# (Cloudflare Worker, desktop offline backend, self-hosted Node server).
# Sign-in is NOT inferred from this value: the app asks the server.
# VITE_API_BASE_URL=https://your-practice.vercel.app

# Optional: comma-separated origins allowed to call the API cross-origin
# (the desktop app connecting to the hosted server). Defaults to "*".
# CORS_ALLOWED_ORIGINS=https://your-practice.vercel.app

# Optional: clinic id used when no authentication is configured.
# DENTAL_CANVAS_DEFAULT_CLINIC=default-practice
