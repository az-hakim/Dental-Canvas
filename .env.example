# Dental Canvas — optional cloud sync / accounts
#
# Copy this file to `.env.local` (or `.env`) and fill in your Supabase project
# values. Leave both unset to build a fully offline-only app — the account UI
# is hidden and nothing else changes.
#
# Find both values in Supabase → Project Settings → API.
#
# ⚠️  NEVER put the service role key here, and never create a VITE_* variable
#     for it. The anon key is designed to be public; Row Level Security limits
#     every table to the signed-in doctor's own rows. Account deletion runs in
#     the supabase/functions/delete-account Edge Function, where the service
#     role key is injected by the Supabase runtime and never reaches a client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
