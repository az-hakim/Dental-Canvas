node_modules
dist
.repro
.wrangler
.clawnify
.DS_Store
*.log
.dev.vars

# Agent scratch space: local logs, generated keys/passwords, CLI output. It
# holds real credentials during local Supabase work, so it never goes to git.
.freebuff/

# Local Supabase credentials / build-time cloud config. `.env.example` is the
# only env file that belongs in git.
.env
.env.*
!.env.example

# Supabase CLI local state (docker volumes, linked project ref, temp keys).
supabase/.temp/
supabase/.branches/
supabase/.env
src-tauri/target
src-tauri/gen/schemas

# Package payloads extracted in the repo root to inspect a release (dpkg-deb -x,
# rpm2cpio, an AppImage's --appimage-extract). They are not source; keeping them
# out of git also keeps them out of the Tailwind scan.
/usr/
/squashfs-root/
/verify/
